# Patterns here are matched against the path relative to the context root, so
# a bare `target/` excludes only the top-level one and silently ships every
# nested build directory. `fuzz/target/` alone is several gigabytes. Anything
# that can appear at more than one depth is written `**/`.

# Rust build output. `**/` because the workspace root, `fuzz/`, and any future
# member each have their own.
**/target/

tla/
.git/
.github/
*.log
pgbattery.long-type-*.txt

# Fuzzing inputs and crashes: regenerated by the fuzzer, never read in-image.
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

testing/artifacts/
testing/two_sync_capture.txt
testing/two_sync_metrics_capture.txt

# Build artifacts that bloat the build context
README.pdf
*.pdf

# Python/dev tooling caches. `testing/` has its own uv venv, so these need to
# match at depth as well as at the root.
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/.venv/
**/*.pyc

# IDE / editor / OS
.idea/
.vscode/
**/.DS_Store
.claude/

# Demo assets aren't needed inside the container
demo/
docs/assets/
